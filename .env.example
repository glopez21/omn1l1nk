OMN1L1NK_AUGUR_ENABLED=true
OMN1L1NK_THREATPULSE_ENABLED=false
OMN1L1NK_POLL_INTERVAL=3
OMN1L1NK_BATCH_SIZE=50
OMN1L1NK_MAX_RETRIES=5
