# n3xusDB superuser (required)
DB_SUPER_PASSWORD=changeme_super

# Per-project DB passwords (required by init/01-create-dbs.sh)
AUGUR_DB_PASSWORD=changeme_augur
TWN_DB_PASSWORD=changeme_twn
EVENTFLOW_DB_PASSWORD=changeme_eventflow
SHARED_DB_PASSWORD=changeme_shared
